# ---- Azure ----
AZURE_SUBSCRIPTION_ID=5423a68c-2f22-4512-a82c-eb6ed44d9aaf
AZURE_RESOURCE_GROUP=nasa-yuwe-mt-rg
AZURE_LOCATION=westus2
AZURE_STORAGE_ACCOUNT=nasayuwemtdata
# Either set a connection string, OR rely on AzureCliCredential (az login) + account name above.
AZURE_STORAGE_CONNECTION_STRING=

# ---- H100 VM ----
H100_VM_NAME=nymt-h100
H100_VM_SIZE=Standard_NC40ads_H100_v5
H100_USE_SPOT=1
H100_ADMIN_USER=azureuser
# Public key used for SSH into the VM (path on this machine).
H100_SSH_PUBKEY=~/.ssh/id_rsa.pub
H100_SSH_KEY=~/.ssh/id_rsa
# Hard ceiling — orchestrator auto-tears-down when VM uptime exceeds this.
H100_MAX_BUDGET_HOURS=6

# ---- Tracking ----
WANDB_API_KEY=
WANDB_PROJECT=nasa-yuwe-mt
WANDB_ENTITY=

# ---- HuggingFace (optional, for gated models) ----
HF_TOKEN=
